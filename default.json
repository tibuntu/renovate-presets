{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
     "config:recommended",
     ":disableRateLimiting",
     ":label(renovate)",
     ":timezone(Europe/Berlin)",
     ":enablePreCommit"
  ],
  "abandonmentThreshold": "6 months",
  "prFooter": "",
  "addLabels": ["{{{manager}}}", "{{{updateType}}}"],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "Active projects with a slow release cadence, not abandoned",
      "matchDepNames": [
        "aquasecurity/trivy-action",
        "adrienverge/yamllint",
        "yamllint",
        "gitleaks/gitleaks",
        "pre-commit/pre-commit-hooks",
        "actions/configure-pages",
        "actions/upload-pages-artifact",
        "bandit",
        "pycqa/bandit"
      ],
      "abandonmentThreshold": null
    }
  ]
}
